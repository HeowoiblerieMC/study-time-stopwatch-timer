Study Time Analyzer


days = [
        "Sunday" ,
        "Monday" ,
        "Tuesday" ,
        "Wednesday" ,
        "Thursday" ,
        "Friday" ,
        "Saturday"
]


hours = [
3.0,
2.5,
1.5,
3.0,
4.0
2.0,
1.0,
]


total = sum(hours)
average = total / len(hours)


best_hours = max(hours)
worst_hours = min(hours)


best_day = days[hours.index(best_hours)]
worst_day = days[hours.index(worst_hours)]


print("=== Study Time Analyzer ===")
print()


print(f"Total Study Time: {total:.1f} hours")
print(f"Average Time: {average:.2f} hours/day")
print()


print(f"Best Day: {best_day} ({best_hours:.1f} h)")
print(f"Worst Day: {worst_day} ({worst_hours:.1f} h)")
print()
 
